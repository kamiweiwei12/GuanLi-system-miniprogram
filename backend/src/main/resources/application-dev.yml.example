# ============================================
# 开发环境配置示例
# ============================================
# 使用方法：
#   1. 复制此文件为 application-dev.yml
#   2. 填入本地 MySQL 密码
#   3. application-dev.yml 已被 .gitignore 忽略，不会提交到 Git
#
# 注意：
#   - 请勿在此文件中填写真实密码
#   - 请勿将 application-dev.yml 提交到 Git
# ============================================

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/inspection_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Taipei
    username: inspection
    password: 你的MYSQL_PASSWORD
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      minimum-idle: 5
      maximum-pool-size: 20
      idle-timeout: 300000
      max-lifetime: 1200000
      connection-timeout: 30000