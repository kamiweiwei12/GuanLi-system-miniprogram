<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.inspection.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.inspection.entity.User">
        <id column="id" property="id"/>
        <result column="openid" property="openid"/>
        <result column="username" property="username"/>
        <result column="phone" property="phone"/>
        <result column="department_id" property="departmentId"/>
        <result column="role_id" property="roleId"/>
        <result column="status" property="status"/>
        <result column="nickname" property="nickname"/>
        <result column="avatar_url" property="avatarUrl"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <resultMap id="UserVOResultMap" type="com.inspection.vo.UserVO">
        <id column="id" property="id"/>
        <result column="nickname" property="nickname"/>
        <result column="phone" property="phone"/>
        <result column="dept_name" property="departmentName"/>
        <result column="role_code" property="roleCode"/>
        <result column="role_name" property="roleName"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.inspection.entity.User"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (
            openid, username, phone, department_id, role_id,
            status, nickname, avatar_url
        ) VALUES (
            #{openid}, #{username}, #{phone}, #{departmentId}, #{roleId},
            #{status}, #{nickname}, #{avatarUrl}
        )
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM sys_user
        WHERE id = #{id} AND is_deleted = 0
    </select>

    <select id="selectByOpenid" resultMap="BaseResultMap">
        SELECT * FROM sys_user
        WHERE openid = #{openid} AND is_deleted = 0
    </select>

    <update id="update" parameterType="com.inspection.entity.User">
        UPDATE sys_user
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="departmentId != null">department_id = #{departmentId},</if>
            <if test="roleId != null">role_id = #{roleId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="avatarUrl != null">avatar_url = #{avatarUrl},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 用户列表分页（JOIN sys_role + sys_department，不含 openid） -->
    <select id="selectPage" parameterType="com.inspection.dto.UserQueryDTO" resultMap="UserVOResultMap">
        SELECT u.id, u.nickname, u.phone, u.status, u.created_at,
               d.dept_name, r.role_code, r.role_name
        FROM sys_user u
        LEFT JOIN sys_department d ON u.department_id = d.id
        LEFT JOIN sys_role r ON u.role_id = r.id
        WHERE u.is_deleted = 0
        <if test="nickname != null and nickname != ''">
            AND u.nickname LIKE CONCAT('%', #{nickname}, '%')
        </if>
        <if test="phone != null and phone != ''">
            AND u.phone LIKE CONCAT('%', #{phone}, '%')
        </if>
        <if test="roleCode != null and roleCode != ''">
            AND r.role_code = #{roleCode}
        </if>
        <if test="departmentId != null">
            AND u.department_id = #{departmentId}
        </if>
        ORDER BY u.created_at DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <!-- 用户总数（带筛选） -->
    <select id="countUsers" parameterType="com.inspection.dto.UserQueryDTO" resultType="long">
        SELECT COUNT(*)
        FROM sys_user u
        LEFT JOIN sys_role r ON u.role_id = r.id
        WHERE u.is_deleted = 0
        <if test="nickname != null and nickname != ''">
            AND u.nickname LIKE CONCAT('%', #{nickname}, '%')
        </if>
        <if test="phone != null and phone != ''">
            AND u.phone LIKE CONCAT('%', #{phone}, '%')
        </if>
        <if test="roleCode != null and roleCode != ''">
            AND r.role_code = #{roleCode}
        </if>
        <if test="departmentId != null">
            AND u.department_id = #{departmentId}
        </if>
    </select>

</mapper>