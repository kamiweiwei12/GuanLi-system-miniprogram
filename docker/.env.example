# ============================================
# Docker 环境变量模板
# 使用方式：
#   1. 复制此文件为项目根目录下的 .env
#   2. 填入真实密码和密钥
#   3. docker compose up -d
#
# 注意：.env 文件已被 .gitignore 排除，不会提交到 Git
# ============================================

# MySQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=inspection_db
MYSQL_USER=
MYSQL_PASSWORD=

# Spring Boot Datasource
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/inspection_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Taipei
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# 文件上传
FILE_UPLOAD_PATH=/data/uploads
FILE_BASE_URL=http://localhost

# 微信小程序（可选，不填则跳过微信登录）
WX_APP_ID=
WX_APP_SECRET=