# ============================================
# Docker 环境变量模板
# 使用方式：
#   1. 复制此文件为项目根目录下的 .env
#   2. 填入真实密码（必填项标记为 [必填]）
#   3. docker compose up -d
#
# 注意：.env 文件已被 .gitignore 排除，不会提交到 Git
# ============================================

# ========== MySQL [必填] ==========
# 以下变量仅在首次创建数据库时生效
# 已存在的 mysql_data volume 不会受变更影响
MYSQL_ROOT_PASSWORD=        # [必填] MySQL root 密码
MYSQL_DATABASE=inspection_db
MYSQL_USER=                 # [必填] 应用连接用户（需与下方一致）
MYSQL_PASSWORD=             # [必填] 应用连接密码（需与下方一致）

# ========== Spring Boot Datasource [必填] ==========
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/inspection_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Taipei
SPRING_DATASOURCE_USERNAME= # [必填] 与 MYSQL_USER 一致
SPRING_DATASOURCE_PASSWORD= # [必填] 与 MYSQL_PASSWORD 一致

# ========== 文件上传 ==========
FILE_UPLOAD_PATH=/data/uploads
FILE_BASE_URL=http://localhost

# ========== 微信小程序 [可选] ==========
WX_APP_ID=
WX_APP_SECRET=
