/* pages/detail/detail.wxss */
.container {
    min-height: 100vh;
    background-color: #f5f5f5;
}

/* Loading & Error */
.loading,
.error {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
    font-size: 28rpx;
    color: #999;
}

.error-text {
    color: #ee0a24;
}

/* Card */
.content {
    padding: 30rpx;
}

.card {
    background-color: #fff;
    border-radius: 12rpx;
    padding: 30rpx;
}

.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20rpx;
    margin-bottom: 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.name {
    font-size: 36rpx;
    font-weight: 600;
    color: #333;
}

.tag {
    display: inline-block;
    padding: 6rpx 20rpx;
    border-radius: 6rpx;
    font-size: 24rpx;
    color: #fff;
}

.tag.success {
    background-color: #07c160;
}

.tag.danger {
    background-color: #ee0a24;
}

.tag.warning {
    background-color: #ff976a;
}

/* Info Grid */
.info-grid {
    display: flex;
    flex-wrap: wrap;
}

.info-item {
    width: 50%;
    margin-bottom: 24rpx;
}

.info-item.full-width {
    width: 100%;
}

.info-label {
    display: block;
    font-size: 24rpx;
    color: #999;
    margin-bottom: 8rpx;
}

.info-value {
    display: block;
    font-size: 28rpx;
    color: #333;
}

.description {
    white-space: pre-wrap;
    line-height: 1.6;
}

/* Images */
.image-section {
    margin-top: 20rpx;
}

.section-title {
    display: block;
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
    margin-bottom: 16rpx;
}

.image-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.preview-image {
    width: 200rpx;
    height: 200rpx;
    border-radius: 8rpx;
}

.no-images {
    padding: 40rpx;
    text-align: center;
}

.no-images-text {
    font-size: 26rpx;
    color: #999;
}