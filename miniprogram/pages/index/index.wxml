<!-- pages/index/index.wxml -->
<!-- 巡检系统首页 — 根据角色显示不同功能入口 -->
<view class="container">
  <view class="welcome">
    <text class="title">巡检管理系统</text>
    <text class="subtitle" wx:if="{{isAdmin}}">管理员模式</text>
    <text class="subtitle" wx:else>员工模式</text>
  </view>

  <view class="actions" wx:if="{{loggedIn}}">
    <!-- 所有人都可新增巡检 -->
    <button class="btn btn-primary" bindtap="goToReport">新增巡检上报</button>

    <!-- EMPLOYEE：查看自己的记录 -->
    <button class="btn btn-secondary" wx:if="{{!isAdmin}}" bindtap="goToRecord">我的巡检记录</button>

    <!-- ADMIN：查看全部记录 -->
    <button class="btn btn-secondary" wx:if="{{isAdmin}}" bindtap="goToRecord">全部巡检记录</button>

    <!-- ADMIN：管理功能入口（预留） -->
    <button class="btn btn-admin" wx:if="{{isAdmin}}" bindtap="goToAdmin">管理功能</button>
  </view>

  <!-- 未登录提示 -->
  <view class="empty" wx:if="{{!loggedIn}}">
    <text class="empty-text">请重新打开小程序以登录</text>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="btn-logout" wx:if="{{loggedIn}}" bindtap="handleLogout">退出登录</button>
  </view>

  <!-- 预留 userInfo 展示位置（未来扩展） -->
  <view class="user-section" wx:if="{{userInfo.nickName}}">
    <text class="user-name">{{userInfo.nickName}}</text>
  </view>
</view>