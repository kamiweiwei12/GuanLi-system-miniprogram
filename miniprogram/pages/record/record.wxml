<!-- pages/record/record.wxml -->
<view class="container">
  <!-- 空状态 -->
  <view class="empty" wx:if="{{list.length === 0 && !loading}}">
    <text class="empty-text">暂无巡检记录</text>
  </view>

  <!-- 列表 -->
  <view class="list" wx:else>
    <view class="item" wx:for="{{list}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="item-header">
        <text class="name">{{item.employeeName}}</text>
        <text class="tag {{item.resultClass}}">{{item.resultText}}</text>
      </view>
      <view class="item-body">
        <text class="detail">部门：{{item.department}}</text>
        <text class="detail">区域：{{item.area}}</text>
        <text class="detail">设备：{{item.deviceName}}</text>
        <text class="detail">时间：{{item.inspectionTime}}</text>
      </view>
      <view class="item-footer">
        <text class="arrow">查看详情 ›</text>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  <view class="no-more" wx:if="{{!hasMore && list.length > 0}}">
    <text>没有更多了</text>
  </view>
</view>