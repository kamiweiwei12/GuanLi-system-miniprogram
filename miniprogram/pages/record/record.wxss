/* pages/record/record.wxss */
.container {
    padding: 0;
}

/* 空状态 */
.empty {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
}

.empty-text {
    font-size: 28rpx;
    color: #999;
}

/* 列表项 */
.item {
    padding: 24rpx 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
    background: #fff;
}

.item-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12rpx;
}

.name {
    font-size: 32rpx;
    font-weight: 500;
    color: #333;
}

.tag {
    display: inline-block;
    padding: 4rpx 16rpx;
    border-radius: 6rpx;
    font-size: 22rpx;
    color: #fff;
}

.tag.success {
    background-color: #07c160;
}

.tag.danger {
    background-color: #ee0a24;
}

.tag.warning {
    background-color: #ff976a;
}

.item-body {
    margin-bottom: 12rpx;
}

.detail {
    display: block;
    font-size: 26rpx;
    color: #666;
    line-height: 1.6;
}

.item-footer {
    display: flex;
    justify-content: flex-end;
}

.arrow {
    font-size: 24rpx;
    color: #999;
}

/* 底部状态 */
.loading-more,
.no-more {
    padding: 24rpx;
    text-align: center;
    font-size: 24rpx;
    color: #999;
}